    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB2E4\uC74C\uC740 \uC774\uC81C \uBB34\uC5ED\uC744 \uC9C4\uD589\uD574\uBCF4\uB3C4\uB85D
