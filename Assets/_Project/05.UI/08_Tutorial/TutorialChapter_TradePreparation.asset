  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_TradePreparation
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: trade_preparation
  title: "\uBB34\uC5ED\uC744 \uC900\uBE44\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC0C1\uD488 \uC801\uC7AC\uB97C \uB9C8\uCCE4\uC2B5\uB2C8\uB2E4. \uC774\uC81C
      \uBB34\uC5ED\uC744 \uB5A0\uB0A0 \uC218 \uC788\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uAE38\uBAA9\uB9C8\uB2E4 \uAC70\uB9AC\uC640 \uC704\uD5D8\uB3C4\uAC00
      \uB2E4\uB974\uAE30 \uB54C\uBB38\uC5D0 \uC5B4\uB290 \uB9C8\uC744\uC744 \uC5B4\uB290
      \uAE38\uC744 \uD1B5\uD574 \uAC08 \uAC83\uC778\uC9C0 \uC798 \uACE8\uB77C\uC57C
      \uD569\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC6A9\uBCD1\uB3C4 \uAD6C\uB9E4\uD558\uB294 \uAC83\uC744 \uAD8C\uC7A5\uB4DC\uB9BD\uB2C8\uB2E4\uC545.
      \uC0B0\uC801\uB4E4\uC5D0\uAC8C\uC11C \uC7AC\uC0B0\uC744 \uC9C0\uCF1C\uC904
      \uAC83\uC785\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_trade_preparation
    label: "\uBB34\uC5ED \uC900\uBE44 \uD654\uBA74\uC744 \uC5EC\uC138\uC694"
  - stepId: confirm_caravan
    label: "\uBB34\uC5ED\uD560 \uCE90\uB7EC\uBC34\uC744 \uC120\uD0DD\uD558\uACE0
      \uB2E4\uC74C\uC744 \uB204\uB974\uC138\uC694"
  - stepId: confirm_route
    label: "\uC774\uB3D9\uD560 \uACBD\uB85C\uB97C \uC120\uD0DD\uD558\uACE0 \uB2E4\uC74C\uC744
      \uB204\uB974\uC138\uC694"
  - stepId: confirm_mercenary
    label: "\uC6A9\uBCD1\uC744 \uC120\uD0DD\uD558\uACE0 \uB2E4\uC74C\uC744 \uB204\uB974\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB4DC\uB514\uC5B4 \uCD9C\uBC1C \uC900\uBE44\uAC00 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4\uC545. 
      \uD639\uC2DC \uC774\uB3D9\uD560 \uB54C \uBB34\uC5B8\uAC00\uAC00 \uBD80\uC871\uD558\uC9C4
      \uC54A\uC740\uC9C0 \uB0B4\uC5ED\uC744 \uD655\uC778\uD574\uBD05\uC2DC\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB9CC\uC57D \uC900\uBE44\uAC00 \uBD80\uC871\uD558\uB2E4\uBA74  \uC608\uC0C1\uD558\uC9C0
      \uBABB\uD55C \uC0AC\uAC74\uC73C\uB85C \uBB34\uC5ED\uC774 \uC2E4\uD328\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.  \uC704\uD5D8\uB3C4\uC640 \uC900\uBE44 \uC0C1\uD0DC\uB97C
      \uAF2D \uD655\uC778\uD55C \uB4A4 \uCD9C\uBC1C\uD569\uC2DC\uB2E4\uC545."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
