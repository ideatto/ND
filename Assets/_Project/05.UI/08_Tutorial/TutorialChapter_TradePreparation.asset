  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_TradePreparation
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: trade_preparation
  title: "\uBB34\uC5ED\uC744 \uC900\uBE44\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC0C1\uD488 \uC801\uC7AC\uB97C \uB9C8\uCCE4\uC5B4\uC694. \uC774\uC81C
      \uBB34\uC5ED\uC744 \uB5A0\uB0A0 \uC2DC\uAC04\uC774 \uC654\uC5B4\uC694!"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC5B4\uB290 \uB9C8\uC744 \uAC08 \uAC83\uC778\uC9C0 \uADF8\uB9AC\uACE0
      \uC5B4\uB5A4 \uAE38\uC744 \uC120\uD0DD\uD560 \uAC83\uC778\uC9C0 \uACE8\uB77C\uC57C
      \uD574\uC694! \uAE38\uBAA9\uC744 \uC798 \uACE0\uB974\uB294 \uAC83\uB3C4 \uC0C1\uC778\uC758
      \uC2E4\uB825\uC774\uC5D0\uC694!"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB2E4\uC74C\uC5D0\uB294 \uC6A9\uBCD1\uC744 \uACE0\uC6A9\uD574\uC57C\uD574\uC694.
      \uC6A9\uBCD1\uC774 \uC5C6\uC774 \uBB34\uC11C\uC6B4 \uC0B0\uC801\uC744 \uB9CC\uB098\uBA74
      \uAC00\uC9C4 \uBB3C\uAC74\uC744 \uC57D\uD0C8\uD574\uAC00\uAC70\uB4E0\uC694."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_trade_preparation
    label: "\uBB34\uC5ED \uC900\uBE44 \uD654\uBA74\uC744 \uC5EC\uC138\uC694"
  - stepId: confirm_caravan
    label: "\uBB34\uC5ED\uD560 \uCE90\uB7EC\uBC34\uC744 \uC120\uD0DD\uD558\uACE0
      \uB2E4\uC74C\uC744 \uB204\uB974\uC138\uC694"
  - stepId: confirm_route
    label: "\uC774\uB3D9\uD560 \uACBD\uB85C\uB97C \uC120\uD0DD\uD558\uACE0 \uB2E4\uC74C\uC744
      \uB204\uB974\uC138\uC694"
  - stepId: confirm_mercenary
    label: "\uC6A9\uBCD1\uC744 \uC120\uD0DD\uD558\uACE0 \uB2E4\uC74C\uC744 \uB204\uB974\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB4DC\uB514\uC5B4 \uCD9C\uBC1C\uD560 \uC900\uBE44\uAC00 \uB05D\uC774\uB124\uC694.
      \uD639\uC2DC \uC774\uB3D9\uD560 \uB54C \uBA39\uC774\uAC00 \uBD80\uC871\uD558\uC9C4
      \uC54A\uC740\uC9C0 \uB0B4\uC5ED\uC744 \uD655\uC778\uD574\uBCFC\uAE4C\uC694?"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uB3D9 \uC911\uC5D0\uB294 \uC608\uC0C1\uD558\uC9C0 \uBABB\uD55C
      \uC0AC\uAC74\uC73C\uB85C \uBB34\uC5ED\uC774 \uC2E4\uD328\uD560 \uC218 \uC788\uC5B4\uC694.
      \uC704\uD5D8\uB3C4\uC640 \uC900\uBE44 \uC0C1\uD0DC\uB97C \uD655\uC778\uD55C
      \uB4A4 \uCD9C\uBC1C\uD558\uC138\uC694."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
