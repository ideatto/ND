  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_TravelAndMap
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: travel_and_map
  title: "\uC774\uB3D9 \uD654\uBA74\uC744 \uD655\uC778\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uC81C \uBB34\uC5ED \uC2DC\uC791\uC774\uC5D0\uC694. \uB2E4\uC74C
      \uB9C8\uC744\uB85C \uC774\uB3D9\uD558\uB294 \uB3D9\uC548 \uC8FC\uBCC0\uC758
      \uACBD\uCE58\uB97C \uD655\uC778\uD574\uBCF4\uC2E4\uB798\uC694?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBBF8\uB2C8\uB9F5\uC744 \uB20C\uB7EC\uC11C \uCE90\uB7EC\uBC34\uC758
      \uC774\uB3D9\uC744 \uD655\uC778\uD558\uAC70\uB098"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uCE90\uB7EC\uBC34\uC744 \uB20C\uB7EC \uC9C1\uC811 \uC774\uB3D9\uD558\uB294
      \uBAA8\uC2B5\uC744 \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694. "
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uBC88 \uC774\uB3D9\uC5D0\uC11C\uB294 \uC6D4\uB4DC\uB9F5\uACFC
      \uCE90\uB7EC\uBC34 \uC774\uB3D9 \uD654\uBA74\uC744 \uBAA8\uB450 \uD655\uC778\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD310\uB9E4\uB294 \uADF8\uB300\uB85C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC774\uB3D9 \uAE30\uB2A5\uC740 \uB2E4\uC74C \uBB34\uC5ED\uC5D0\uC11C \uB2E4\uC2DC
      \uD655\uC778\uD574 \uBCF4\uC138\uC694."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  steps:
  - stepId: depart_trade
    label: "\uC694\uC57D\uCC3D\uC5D0\uC11C \uCD9C\uBC1C\uD558\uC138\uC694"
  - stepId: open_world_map
    label: "\uC6D4\uB4DC\uB9F5\uC744 \uC5F4\uC5B4 \uC774\uB3D9 \uC0C1\uD669\uC744
      \uD655\uC778\uD558\uC138\uC694"
  - stepId: open_treadmill
    label: "\uC774\uB3D9 \uC911\uC778 \uCE90\uB7EC\uBC34\uC758 \uC774\uB3D9 \uD654\uBA74\uC744
      \uC5EC\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC88B\uC2B5\uB2C8\uB2E4. \uC6D4\uB4DC\uB9F5\uC5D0\uC11C\uB294 \uCE90\uB7EC\uBC34\uC758
      \uC774\uB3D9 \uC704\uCE58\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uB3D9 \uD654\uBA74\uC5D0\uC11C\uB294 \uCE90\uB7EC\uBC34\uC758
      \uD604\uC7AC \uC5EC\uC815\uC744 \uC9C1\uC811 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
