  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_ArrivalSelling
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: arrival_selling
  title: "\uB3C4\uCC29\uD55C \uC0C1\uD488\uC744 \uD310\uB9E4\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB4DC\uB514\uC5B4 \uB2E4\uB978 \uB9C8\uC744\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4\uC545!
      \uC815\uC0B0\uC744 \uC2DC\uC791\uD558\uACA0\uC2B5\uB2C8\uB2E4\uC545!"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD310\uB9E4\uB420 \uBB3C\uD488\uC740 \uACC4\uC808\uACFC \uC774\uB3D9\uD574\uC628
      \uAC70\uB9AC\uC5D0 \uB530\uB77C \uAC00\uACA9\uC774 \uB2EC\uB77C\uC9D1\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uC724\uC744 \uD06C\uAC8C \uC5BB\uC73C\uB824\uBA74 \uACC4\uC808\uACFC
      \uAC70\uB9AC\uB97C \uC798 \uC774\uC6A9\uD574\uC57C \uD569\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB300\uC2E0 \uAC70\uB9AC\uAC00 \uBA40 \uC218\uB85D \uC0B0\uC801\uB4E4\uC774
      \uB098\uD0C0\uB0A0 \uD655\uB960\uC774 \uB192\uC73C\uB2C8 \uC870\uC2EC\uD574\uC57C\uD569\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBB34\uC5ED\uC5D0 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4\uC545.."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBB34\uC5ED\uC5D0 \uC2E4\uD328 \uD588\uC744 \uB54C\uB294 \uAC00\uC9C0\uACE0
      \uC788\uB358 \uBB3C\uD488\uC744 \uC804\uBD80 \uC783\uC5B4\uBC84\uB9BD\uB2C8\uB2E4\uC545.."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD310\uB9E4\uC5D0 \uAD00\uD574\uC11C\uB294 \uB2E4\uC74C\uC5D0 \uC54C\uB824\uB4DC\uB9AC\uB3C4\uB85D
      \uD558\uACA0\uC2B5\uB2C8\uB2E4\uC545.."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  steps:
  - stepId: open_arrival_sale
    label: "\uB3C4\uCC29\uD55C \uCE90\uB7EC\uBC34\uC758 \uD310\uB9E4 \uD654\uBA74\uC744
      \uC5EC\uC138\uC694"
  - stepId: create_sale_draft
    label: "\uD310\uB9E4\uD560 \uC0C1\uD488\uACFC \uC218\uB7C9\uC744 \uC120\uD0DD\uD558\uC138\uC694"
  - stepId: confirm_sale
    label: "\uD310\uB9E4\uB97C \uD655\uC815\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD310\uB9E4\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4\uC545
      \uC815\uC0B0\uCC3D\uC5D0\uC11C \uC2B9\uC778\uC744 \uD574\uC8FC\uC154\uC57C
      \uD569\uB2C8\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC815\uC0B0\uCC3D\uC5D0\uB294 \uC774\uBC88 \uBB34\uC5ED\uC5D0 \uC4F0\uC774\uAC70\uB098
      \uBC8C\uC5B4\uB4DC\uB9B0 \uBE44\uC6A9\uC744 \uD55C\uB208\uC5D0 \uD30C\uC545\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
