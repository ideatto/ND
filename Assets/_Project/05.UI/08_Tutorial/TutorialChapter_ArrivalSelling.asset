--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_ArrivalSelling
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: arrival_selling
  title: "\uB3C4\uCC29\uD55C \uC0C1\uD488\uC744 \uD310\uB9E4\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC5D0\uD6A8 \uD53C\uACE4\uD574\uB77C... \uB4DC\uB514\uC5B4 \uB2E4\uB978
      \uB9C8\uC744\uC5D0 \uB3C4\uCC29\uD588\uAD70\uC694!"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uC81C \uC990\uAC70\uC6B4 \uC815\uC0B0 \uC2DC\uAC04\uC774\uC5D0\uC694
      \uAC00\uC838\uC628 \uC0C1\uD488\uC744 \uD310\uB9E4\uD574 \uBCFC\uAE4C\uC694?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD310\uB9E4\uB420 \uBB3C\uD488\uC740 \uACC4\uC808\uACFC \uC774\uB3D9\uD574\uC628
      \uAC70\uB9AC\uC5D0 \uB530\uB77C \uAC00\uACA9\uC774 \uB2EC\uB77C\uC838\uC694~"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB7EC\uB2C8 \uACC4\uC808\uC5D0 \uC815\uB9D0 \uD544\uC694\uD55C
      \uBB3C\uAC74\uACFC \uBCF4\uB2E4 \uBA3C\uAC70\uB9AC\uB97C \uC774\uB3D9\uD574\uC11C
      \uBB3C\uAC74\uC744 \uD30C\uB294\uAC8C \uC774\uC724\uC774 \uD06C\uAC8C \uB098\uACA0\uC8E0?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB7F0\uB370 \uC774\uB3D9\uD558\uB294 \uAC70\uB9AC\uAC00 \uBA40
      \uC218\uB85D \uC0B0\uC801\uC774 \uB098\uD0C0\uB0A0 \uD655\uB960\uC774 \uB354
      \uB192\uC544\uC9C0\uB2C8\uAE4C \uC870\uC2EC \uB610 \uC870\uC2EC\uD574\uC57C
      \uD574\uC694!"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD750\uC789... \uBB34\uC5ED\uC5D0 \uC2E4\uD328\uD558\uACE0 \uB9D0\uC558\uB124\uC694..."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBB34\uC5ED\uC5D0 \uC2E4\uD328 \uD588\uC744 \uB54C\uB294 \uAC00\uC9C0\uACE0
      \uC788\uB358 \uBB3C\uD488\uC744 \uC804\uBD80 \uC783\uC5B4\uBC84\uB824\uC694.
      \uB9C8\uCC28\uC640 \uB9D0 \uADF8\uB9AC\uACE0 \uC2E4\uC740 \uBB3C\uAC74\uB4E4
      \uC804\uBD80\uC694."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB7EC\uB2C8 \uC720\uC0AC\uC2DC\uB97C \uB300\uBE44\uD574\uC11C
      \uBC18\uB4DC\uC2DC \uC6A9\uBCD1\uC744 \uB370\uB9AC\uACE0 \uB2E4\uB140\uC57C
      \uD574\uC694."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB7EC\uB2C8 \uC720\uC0AC\uC2DC\uB97C \uB300\uBE44\uD574\uC11C
      \uBC18\uB4DC\uC2DC \uC6A9\uBCD1\uC744 \uB370\uB9AC\uACE0 \uB2E4\uB140\uC57C
      \uD574\uC694."
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB7EC\uBA74 \uBB34\uC5ED\uC5D0 \uC131\uACF5\uD560 \uB54C \uB2E4\uC2DC
      \uD310\uB9E4 \uBC29\uBC95\uC744 \uC54C\uB824\uB4DC\uB9AC\uB3C4\uB85D \uD560\uAC8C\uC694!"
    emotion: 3
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  steps:
  - stepId: open_arrival_sale
    label: "\uB3C4\uCC29\uD55C \uCE90\uB7EC\uBC34\uC758 \uD310\uB9E4 \uD654\uBA74\uC744
      \uC5EC\uC138\uC694"
  - stepId: create_sale_draft
    label: "\uD310\uB9E4\uD560 \uC0C1\uD488\uACFC \uC218\uB7C9\uC744 \uC120\uD0DD\uD558\uC138\uC694"
  - stepId: confirm_sale
    label: "\uD310\uB9E4\uB97C \uD655\uC815\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD310\uB9E4\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uD310\uB9E4\uD558\uC9C0
      \uC54A\uC740 \uC0C1\uD488\uC740 \uCE90\uB7EC\uBC34\uC5D0 \uADF8\uB300\uB85C
      \uB0A8\uC2B5\uB2C8\uB2E4."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uC81C \uC815\uC0B0 \uD654\uBA74\uC5D0\uC11C \uC774\uBC88 \uBB34\uC5ED\uC758
      \uACB0\uACFC\uB97C \uD655\uC778\uD558\uC138\uC694."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
