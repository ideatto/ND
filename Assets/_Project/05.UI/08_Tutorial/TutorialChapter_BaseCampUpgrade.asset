  chapterId: basecamp_upgrade
  title: "\uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uC81C \uB9C8\uC9C0\uB9C9 \uC548\uB0B4\uC5D0\uC694. \uBCA0\uC774\uC2A4
      \uCEA0\uD504\uC5D0 \uBB3C\uAC74\uC744 \uC2E3\uB294 \uBC29\uBC95\uACFC \uAC74\uBB3C\uC744
      \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uB294 \uBC29\uBC95\uC744 \uC54C\uB824\uB4DC\uB9B4\uAC8C\uC694."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uCC3D\uACE0\uB97C \uC5F4\uACE0 \uBB3C\uAC74\uC744 \uB123\uC744 \uCE74\uB77C\uBC18\uC744
      \uC120\uD0DD\uD558\uC138\uC694. \uB2F9\uC5F0\uD788 \uBCA0\uC774\uC2A4\uCEA0\uD504\uC5D0
      \uC5C6\uB294 \uCE74\uB77C\uBC18\uC758 \uBB3C\uAC74\uC744 \uB123\uC744 \uC218
      \uC5C6\uACA0\uC8E0?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBB3C\uAC74\uC744 \uCC3D\uACE0\uC5D0 \uB123\uC740 \uB2E4\uC74C\uC5D4
      \uD574\uB2F9 \uBB3C\uAC74\uB4E4\uB85C \uAC74\uBB3C\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC
      \uC2DC\uD0AC \uC218 \uC788\uC5B4\uC694."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uAC74\uBB3C\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uB294 \uBC29\uBC95\uC740
      \uAC74\uC124 \uBC29\uBC95\uACFC \uB611\uAC19\uC544\uC694!"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_warehouse
    label: "\uCC3D\uACE0 \uD328\uB110\uC744 \uC5EC\uC138\uC694"
  - stepId: store_any_item
    label: "\uCC3D\uACE0\uC5D0 \uC544\uBB34 \uBB3C\uAC74\uC774\uB098 \uD558\uB098
      \uB123\uC73C\uC138\uC694"
  - stepId: open_building_catalog
    label: "+ \uBC84\uD2BC\uC744 \uB20C\uB7EC \uAC74\uBB3C \uBAA9\uB85D\uC744 \uC5EC\uC138\uC694"
  - stepId: select_basecamp_upgrade
    label: "\uAC74\uBB3C \uBAA9\uB85D\uC5D0\uC11C \uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C
      \uC120\uD0DD\uD558\uC138\uC694"
  - stepId: confirm_basecamp_upgrade
    label: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uC644\uB8CC\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uAC78\uB85C \uD29C\uD1A0\uB9AC\uC5BC\uC740 \uB05D\uC774\uC5D0\uC694.
      \uC0C1\uB2E8\uC8FC\uB2D8 \uACE0\uC0DD \uB9CE\uC73C\uC168\uC5B4\uC694~"
