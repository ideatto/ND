  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_BaseCampUpgrade
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: basecamp_upgrade
  title: "\uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uC81C \uB9C8\uC9C0\uB9C9 \uC548\uB0B4\uC785\uB2C8\uB2E4\uC545.
      \uBCA0\uC774\uC2A4 \uCEA0\uD504\uC5D0 \uBB3C\uAC74\uC744 \uC2E3\uB294 \uBC29\uBC95\uACFC
      \uAC74\uBB3C\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uB294 \uBC29\uBC95\uC744
      \uC54C\uB824\uB4DC\uB9AC\uAC9F\uC2B5\uB2C8\uB2E4\uC545."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uCC3D\uACE0\uB97C \uC5F4\uACE0 \uBB3C\uAC74\uC744 \uB123\uC744 \uCE90\uB7EC\uBC18\uC744
      \uC120\uD0DD\uD574\uC57C\uD569\uB2C8\uB2E4\uC545. \uB2F9\uC5F0\uD788 \uBCA0\uC774\uC2A4\uCEA0\uD504\uC5D0
      \uC5C6\uB294 \uCE90\uB7EC\uBC18\uC744 \uC120\uD0DD\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD544\uC694\uD55C \uAC74\uC124\uC7AC\uB8CC\uB97C \uCC3D\uACE0\uC5D0
      \uB123\uC73C\uBA74 \uAC74\uBB3C\uC744 \uAC74\uC124\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uAC74\uBB3C\uC744 \uC5C5\uADF8\uB808\uC774\uB4DC \uD558\uB294 \uBC29\uBC95\uC740
      \uAC74\uC124 \uBC29\uBC95\uACFC \uB611\uAC19\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_warehouse
    label: "\uCC3D\uACE0 \uD328\uB110\uC744 \uC5EC\uC138\uC694"
  - stepId: store_any_item
    label: "\uCC3D\uACE0\uC5D0 \uC544\uBB34 \uBB3C\uAC74\uC774\uB098 \uD558\uB098
      \uB123\uC73C\uC138\uC694"
  - stepId: open_building_catalog
    label: "+ \uBC84\uD2BC\uC744 \uB20C\uB7EC \uAC74\uBB3C \uBAA9\uB85D\uC744 \uC5EC\uC138\uC694"
  - stepId: select_basecamp_upgrade
    label: "\uAC74\uBB3C \uBAA9\uB85D\uC5D0\uC11C \uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C
      \uC120\uD0DD\uD558\uC138\uC694"
  - stepId: confirm_basecamp_upgrade
    label: "\uD655\uC778 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC5C5\uADF8\uB808\uC774\uB4DC\uB97C
      \uC644\uB8CC\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uAC78\uB85C \uD29C\uD1A0\uB9AC\uC5BC\uC740 \uB05D\uC785\uB2C8\uB2E4\uC545
      \uC774\uC81C \uC2A4\uC2A4\uB85C\uC758 \uD798\uC73C\uB85C \uC0C1\uB2E8\uC744
      \uAD74\uB7EC\uAC00\uC2DC\uBA74 \uB429\uB2C8\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uAE08\uD654\uB85C \uD638\uC218\uB97C \uBA54\uC6B8\uB9CC\uD07C \uBD80~\uC790\uAC00
      \uB418\uAE30\uB97C \uAE30\uC6D0\uD569\uB2C8\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
