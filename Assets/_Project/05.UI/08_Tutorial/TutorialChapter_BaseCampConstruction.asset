  m_Script: {fileID: 11500000, guid: 97767bc6e2d8b004f8dd1ab27f0297e8, type: 3}
  m_Name: TutorialChapter_BaseCampConstruction
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Tutorial.TutorialChapterData
  chapterId: basecamp_construction
  title: "\uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C \uAC74\uC124\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC548\uB155\uD558\uC138\uC694! \uB2F9\uC2E0\uC774 \uBC14\uB85C \uC774\uBC88\uC5D0
      \uC0C8\uB85C \uD30C\uACAC\uB41C \uC0C1\uB2E8\uC8FC\uB2D8\uC774\uB85C\uAD70\uC694?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 21300000, guid: 0f8564ffbbc0c7541a22901702e4b311, type: 3}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uCC98\uC74C \uC624\uC168\uC73C\uB2C8 \uC81C\uAC00 \uC5B4\uB5BB\uAC8C
      \uC0C1\uB2E8\uC744 \uC6B4\uC601\uD558\uC154\uC57C \uD558\uB294\uC9C0 \uBC29\uBC95\uC744
      \uC54C\uB824\uB4DC\uB9B4\uAED8\uC694."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC6B0\uC120 \uD558\uB2E8 \uBC11\uC5D0 \uC788\uB294 +\uD0A4\uB97C \uB20C\uB7EC\uC11C
      \uAC74\uBB3C\uC744 \uC81C\uC791 \uD574\uC57C\uD574\uC694,"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 21300000, guid: 4a43e846078434b41a77655d3e8209c4, type: 3}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB9C8\uC744 \uAFB8\uBBF8\uAE30\uC5D0\uC11C \uAC74\uBB3C \uCD94\uAC00
      \uBC84\uD2BC\uC744 \uB204\uB974\uACE0 \uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C
      \uB20C\uB7EC\uC11C \uAC74\uC124\uD574\uBCF4\uC2DC\uACA0\uC5B4\uC694?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_building_catalog
    label: "+ \uBC84\uD2BC\uC73C\uB85C \uAC74\uBB3C \uBAA9\uB85D\uC744 \uC5EC\uC138\uC694"
  - stepId: select_basecamp
    label: "\uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C \uC120\uD0DD\uD558\uC138\uC694"
  - stepId: build_basecamp
    label: "\uAC74\uC124\uC744 \uD655\uC815\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC798\uD558\uC168\uC5B4\uC694! \uBCA0\uC774\uC2A4 \uCEA0\uD504\uAC00
      \uC644\uC131 \uB418\uC5C8\uC5B4\uC694!"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC774\uB7F0 \uD45C\uC2DC\uAC00 \uB5A0\uC11C \uB2F9\uD639\uC2A4\uB7EC\uC6B0\uC168\uACA0\uC8E0?
      \uC77C\uB2E8\uC740 \uBB34\uC2DC\uD558\uACE0 \uB2E4\uB978 \uAC74\uBB3C\uBD80\uD130
      \uB9CC\uB4E4\uC5B4\uBCF4\uC790\uAD6C\uC694."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBCA0\uC774\uC2A4\uCEA0\uD504\uB97C \uAC74\uC124\uD588\uC73C\uB2C8
      \uC774\uC81C \uB2E4\uB978 \uD544\uC218 \uAC74\uBB3C\uC744 \uAC74\uC124\uD560
      \uC218 \uC788\uAC8C \uB418\uC5C8\uC5B4\uC694~"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
