    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 21300000, guid: 0f8564ffbbc0c7541a22901702e4b311, type: 3}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uCC98\uC74C \uC624\uC168\uC73C\uB2C8 \uC5B4\uB5BB\uAC8C \uC0C1\uB2E8\uC744
      \uC6B4\uC601\uD558\uC154\uC57C \uD558\uB294\uC9C0 \uC54C\uB824\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uC6B0\uC120 \uD558\uB2E8 \uBC11\uC5D0 \uC788\uB294 +\uD0A4\uB97C \uB20C\uB7EC\uC11C
      \uAC74\uBB3C\uC744 \uC81C\uC791 \uD574\uC57C\uD569\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 21300000, guid: 71d342c10ff057a4096339717395e445, type: 3}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB9C8\uC744 \uAFB8\uBBF8\uAE30\uC5D0\uC11C \uAC74\uBB3C \uCD94\uAC00
      \uBC84\uD2BC\uC744 \uB204\uB974\uACE0 \uBCA0\uC774\uC2A4 \uCEA0\uD504\uB97C
      \uB20C\uB7EC\uC11C \uAC74\uC124\uC744 \uB204\uB974\uBA74 \uB429\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_building_catalog
    label: "+ \uBC84\uD2BC\uC73C\uB85C \uAC74\uBB3C \uBAA9\uB85D\uC744 \uC5EC\uC138\uC694"
