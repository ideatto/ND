    label: "\uAC74\uC124\uC744 \uD655\uC815\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uBCA0\uC774\uC2A4\uCEA0\uD504\uAC00 \uC644\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4\uC545"
