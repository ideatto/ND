    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB9F5\uC5D0 \uACA9\uC790\uBB34\uB2AC\uAC00 \uC0DD\uACBC\uC9C0\uB9CC
      \uC815\uC0C1\uC801\uC785\uB2C8\uB2E4\uC545 \uC774 \uC0C1\uD0DC\uC5D0\uC11C
