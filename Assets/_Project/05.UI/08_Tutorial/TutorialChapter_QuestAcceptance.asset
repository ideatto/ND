  chapterId: quest_acceptance
  title: "\uB9C8\uC744 \uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB9C8\uC744\uB9C8\uB2E4 \uD018\uC2A4\uD2B8\uAC00 \uC874\uC7AC\uD569\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD018\uC2A4\uD2B8 \uBCF4\uC0C1\uC5D0\uB294 \uC0B0\uC801 \uC870\uC6B0
      \uD655\uB960\uC774 \uAC10\uC18C\uB418\uAC70\uB098 \uD2B9\uC0B0\uD488\uC774
      \uC5F4\uB9AC\uAC70\uB098 \uC0C8\uB85C\uC6B4 \uB9C8\uC744\uB85C \uAC08 \uC218
      \uC788\uB294 \uB4F1"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB2E4\uC591\uD55C \uBCF4\uC0C1\uC744 \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_quest_menu
    label: "\uD018\uC2A4\uD2B8 \uBA54\uB274\uB97C \uC5EC\uC138\uC694"
  - stepId: select_quest_caravan
    label: "\uD018\uC2A4\uD2B8\uB97C \uD655\uC778\uD560 \uCE90\uB7EC\uBC18\uC744
