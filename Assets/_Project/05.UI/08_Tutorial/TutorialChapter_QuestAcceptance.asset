  - stepId: select_quest
    label: "\uC218\uB77D\uD560 \uD018\uC2A4\uD2B8\uB97C \uC120\uD0DD\uD558\uC138\uC694"
  - stepId: accept_quest
    label: "\uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD588\uC2B5\uB2C8\uB2E4\uC545.
      \uC870\uAC74\uC744 \uCDA9\uC871\uD55C \uCE90\uB7EC\uBC18\uC774 \uB2F9\uB3C4\uD558\uBA74
      \uD018\uC2A4\uD2B8\uB97C \uD574\uACB0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD018\uC2A4\uD2B8 \uB2EC\uC131 \uC870\uAC74\uC774 \uB418\uBA74 \uB2E4\uC2DC
      \uD018\uC2A4\uD2B8 \uD328\uB110\uC744 \uC5F4\uC5B4\uC11C \uD574\uB2F9 \uCE90\uB7EC\uBC18\uC744
      \uC120\uD0DD\uD558\uACE0 \uD574\uACB0\uC744 \uB204\uB974\uBA74 \uB429\uB2C8\uB2E4\uC545"
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
