  chapterId: quest_acceptance
  title: "\uB9C8\uC744 \uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD558\uC138\uC694"
  presentationVersion: 1
  introDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uB9C8\uC744\uC5D0\uC11C\uB294 \uCE90\uB7EC\uBC18\uC744 \uD1B5\uD574
      \uC0C8\uB85C\uC6B4 \uD018\uC2A4\uD2B8\uB97C \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD55C \uB4A4 \uC870\uAC74\uC744
      \uCDA9\uC871\uD558\uBA74 \uD574\uB2F9 \uB9C8\uC744\uC5D0\uC11C \uACB0\uC81C\uD558\uC5EC
      \uD574\uACB0\uD560 \uC218 \uC788\uC5B4\uC694."
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uADF8\uB7FC \uC9C0\uAE08 \uBCA0\uC774\uC2A4\uCEA0\uD504\uC5D0\uC11C
      \uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD574\uBCFC\uAE4C\uC694?"
    emotion: 0
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  failureDialogue: []
  steps:
  - stepId: open_quest_menu
    label: "\uD018\uC2A4\uD2B8 \uBA54\uB274\uB97C \uC5EC\uC138\uC694"
  - stepId: select_quest_caravan
    label: "\uD018\uC2A4\uD2B8\uB97C \uD655\uC778\uD560 \uCE90\uB7EC\uBC18\uC744
