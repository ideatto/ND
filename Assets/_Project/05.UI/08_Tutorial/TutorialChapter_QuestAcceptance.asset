    label: "\uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD558\uC138\uC694"
  completionDialogue:
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uD018\uC2A4\uD2B8\uB97C \uC218\uB77D\uD588\uC5B4\uC694. \uC870\uAC74\uC744
      \uCDA9\uC871\uD55C \uB4A4 \uD018\uC2A4\uD2B8\uB97C \uB2E4\uC2DC \uC5F4\uC5B4
      \uD574\uACB0\uD558\uC138\uC694."
    emotion: 1
    npcSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  - npcName: "\uC548\uB0B4\uC778"
    message: "\uACB0\uC81C \uAC00\uB2A5\uD55C \uC0C1\uD0DC\uAC00 \uB418\uBA74 \uCE90\uB7EC\uBC18
