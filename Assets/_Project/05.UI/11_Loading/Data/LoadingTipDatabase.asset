  m_Script: {fileID: 11500000, guid: db6c881e00c782d449148ff14d892907, type: 3}
  m_Name: LoadingTipDatabase
  m_EditorClassIdentifier: Assembly-CSharp::ND.UI.Loading.LoadingTipDatabase
  tips:
  - "\uC2DD\uB7C9\uC740 \uC774\uB3D9 \uC911 \uACC4\uC18D \uC18C\uBAA8\uB429\uB2C8\uB2E4."
  - "\uB9C8\uCC28\uC758 \uCD5C\uB300 \uC801\uC7AC\uB7C9\uC744 \uCD08\uACFC\uD558\uBA74
    \uCD9C\uBC1C\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uC801\uC815 \uC801\uC7AC\uB7C9\uC744 \uB118\uC73C\uBA74 \uC774\uB3D9 \uC18D\uB3C4\uAC00
    \uAC10\uC18C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uACAC\uC778 \uB3D9\uBB3C\uC740 \uAC19\uC740 \uC885\uB958\uB85C \uAD6C\uC131\uD574\uC57C
    \uD569\uB2C8\uB2E4."
  - "\uBB34\uC5ED\uC774 \uB05D\uB098\uBA74 \uC815\uC0B0\uC744 \uC218\uB839\uD574\uC57C
    \uB2E4\uC74C \uBB34\uC5ED\uC744 \uC900\uBE44\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uBAA9\uC801\uC9C0\uC640 \uC0C1\uD488\uC5D0 \uB530\uB77C \uC608\uC0C1 \uC218\uC775\uC774
    \uB2EC\uB77C\uC9D1\uB2C8\uB2E4."
  - "\uB9C8\uCC28\uC758 \uB0B4\uAD6C\uB3C4\uAC00 \uB0AE\uC73C\uBA74 \uB2E4\uC74C
    \uCD9C\uBC1C \uC804\uC5D0 \uC0C1\uD0DC\uB97C \uD655\uC778\uD558\uC138\uC694."
  - "\uC5EC\uB7EC Caravan\uC740 \uAC01\uAC01 \uBCC4\uB3C4\uC758 \uBB34\uC5ED\uC744
    \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uACC4\uC808\uACFC \uC7AC\uB09C\uC740 \uC774\uB3D9\uACFC \uC2DC\uC7A5 \uC0C1\uD669\uC5D0
    \uC601\uD5A5\uC744 \uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "Traveling \uC0C1\uD0DC\uC5D0\uC11C\uB3C4 \uAC8C\uC784\uC744 \uC885\uB8CC\uD558\uACE0
    \uC774\uC5B4\uC11C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  fallbackTip: "\uC5EC\uD589 \uC900\uBE44\uB97C \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4\u2026"
